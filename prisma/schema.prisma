// ZF Alquiler Digital — esquema base (Fase 1).
// Separación de dominios según PRD 20.4:
//   CatalogProperty     → datos comerciales del catálogo autorizado de ZF (fuente externa).
//   PropertyEnrichment  → contenido local verificado por ZF; NUNCA se sobrescribe al sincronizar (RN-002).
// Consultas, postulaciones, medios y guías de servicios se agregan en fases 2–5.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Availability {
  AVAILABLE   // disponible, confirmado por la fuente o por ZF
  RESERVED
  RENTED
  WITHDRAWN   // retirada de publicación
  UNCONFIRMED // la fuente no permite confirmar: requiere validación humana (9.4)
}

enum VerificationLevel {
  VERIFIED
  ESTIMATED
  NOT_AVAILABLE
}

enum Role {
  AGENT
  ADMIN
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model CatalogProperty {
  id             String       @id @default(cuid())
  source         String       // p. ej. "fixture", "manual-import", "tokko"
  externalId     String
  title          String
  description    String?
  propertyType   String?
  neighborhood   String?
  addressDisplay String?      // con el nivel de precisión autorizado (RF-003)
  rentAmount     Decimal?     @db.Decimal(14, 2)
  rentCurrency   String?      @db.VarChar(3)
  bedrooms       Int?
  rooms          Int?
  coveredAreaM2  Decimal?     @db.Decimal(10, 2)
  availability   Availability @default(UNCONFIRMED)
  publishable    Boolean      @default(false) // habilitada por ZF para este canal (RF-001)
  rawPayload     Json?        // copia normalizable del origen, sin datos personales
  lastSeenAt     DateTime?
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enrichment PropertyEnrichment?

  @@unique([source, externalId])
  @@index([availability, publishable])
  @@index([neighborhood])
}

model PropertyEnrichment {
  id                String            @id @default(cuid())
  propertyId        String            @unique
  property          CatalogProperty   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  slug              String            @unique
  videoUrl          String?
  tourUrl           String?
  floorPlanUrl      String?
  measurementsLevel VerificationLevel @default(NOT_AVAILABLE)
  measurementsDate  DateTime?
  measurementsBy    String?
  notes             String?
  reviewedById      String?
  reviewedBy        User?             @relation(fields: [reviewedById], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  role         Role      @default(AGENT)
  passwordHash String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reviewedEnrichments PropertyEnrichment[]
  auditEvents         AuditEvent[]
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String   // p. ej. "property.publish", "enrichment.update"
  entityType String
  entityId   String
  changes    Json?    // sin secretos ni datos sensibles
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SyncRun {
  id         String     @id @default(cuid())
  source     String
  status     SyncStatus @default(RUNNING)
  startedAt  DateTime   @default(now())
  finishedAt DateTime?
  created    Int        @default(0)
  updated    Int        @default(0)
  removed    Int        @default(0)
  errors     Json?

  @@index([source, startedAt])
}
